{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareersLowGoldenCase",
  "description": "One resume+JD pair with human-labeled requirements for eval",
  "type": "object",
  "required": ["id", "job_title", "raw_resume", "raw_jd", "requirements"],
  "properties": {
    "id": { "type": "string" },
    "layer": {
      "enum": ["control", "realism"],
      "description": "control = curated regression set; realism = public-style messy pairs"
    },
    "source": {
      "type": "string",
      "description": "Provenance e.g. inspired_by:batuhanmtl/job_resume_fit#Data Science"
    },
    "source_category": { "type": "string" },
    "job_title": { "type": "string" },
    "raw_resume": { "type": "string" },
    "raw_jd": { "type": "string" },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "gold_bucket"],
        "properties": {
          "requirement": { "type": "string", "description": "JD requirement text (must match parsed JD skill)" },
          "gold_bucket": { "enum": ["strong", "weak", "gap"] },
          "gold_score_min": { "type": "integer", "minimum": 1, "maximum": 10 },
          "gold_score_max": { "type": "integer", "minimum": 1, "maximum": 10 },
          "relevant_resume_snippets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Phrases that MUST appear in retrieved evidence if retrieval is correct"
          },
          "label_notes": { "type": "string", "description": "Why a human assigned this bucket" }
        }
      }
    },
    "duty_requirements": {
      "type": "array",
      "description": "JD duty themes — retrieval eval uses experience+projects sections only",
      "items": {
        "type": "object",
        "required": ["requirement", "gold_bucket"],
        "properties": {
          "requirement": { "type": "string", "description": "Duty theme label (search query)" },
          "gold_bucket": { "enum": ["strong", "weak", "gap"] },
          "gold_score_min": { "type": "integer", "minimum": 1, "maximum": 10 },
          "gold_score_max": { "type": "integer", "minimum": 1, "maximum": 10 },
          "relevant_resume_snippets": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Phrases expected in experience/project chunks"
          },
          "label_notes": { "type": "string" }
        }
      }
    }
  }
}
